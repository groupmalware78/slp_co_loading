generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Kept in sync with ../../admin/prisma/schema.prisma's Role enum — both
// apps share this Postgres enum type on the same database (see the
// User model below, the "users" table itself is shared too), so a
// change to one side without the other causes Prisma's query engine to
// reject any row whose role isn't in its own copy of the enum.
enum Role {
  ADMIN
  SCANNER
  LOGGER
  CSR
}

enum PackageStatus {
  // A customer-created pre-alert for a shipment that hasn't physically
  // arrived at the warehouse yet — see the comment on Package below.
  PENDING
  RECEIVED
  SHIPPED
  AT_CUSTOMS
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  DAMAGED
  EMPTY_PACKAGE
  RETURNED
}

// Independent of PackageStatus — a package can be PAID before it's
// DELIVERED, or DELIVERED (customer has it in hand) while still UNPAID.
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PackageType {
  BOX
  BAG
  ENVELOPE
  OTHER
}

enum PortalRole {
  ADMIN
  CSR
  CUSTOMER
  DRIVER
  // Package-details editor for customer-portal staff — everything a CSR
  // could edit on a package except payment status/amount (see
  // customer-portal's lib/rbac.ts editablePackageFields), plus scan-to-
  // locate access to jump straight to a package's edit modal.
  LOGGER
}

// Which of a package's measurements a FeeRange tier is matched against —
// see the comment on FeeRange below.
enum FeeBasis {
  WEIGHT
  VALUE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditEntity {
  PACKAGE
  COMPANY
  CUSTOMER
  USER
  MANIFEST
}

// FULL grants read+write on every /v1/** route for the tenant; READ_ONLY
// is rejected (403) on any non-GET/HEAD request — see the method-based
// check in ../../api/src/lib/internalAuth.ts.
enum ApiKeyScope {
  FULL
  READ_ONLY
}

// Which flow produced an ApiKeyRotationEvent row — see the comment there.
enum ApiKeyRotationTrigger {
  ADMIN_MANUAL
  PORTAL_MANUAL
  AUTOMATIC
}

// A tenant's chosen email-sending provider for its own PortalSettings —
// see the fields below. Null (the default) means "use the platform's
// shared RESEND_API_KEY," today's behavior for every existing company.
enum EmailProvider {
  RESEND
  SMTP
}

enum DeliveryStatus {
  // Customer-requested home delivery, no driver assigned yet — see the
  // comment on DeliveryAssignment.driverId.
  REQUESTED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SCANNER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  packagesLogged Package[]  @relation("PackagesLoggedBy")
  auditLogs      AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType AuditEntity
  entityId   String
  action     AuditAction
  changes    Json?
  createdAt  DateTime    @default(now())

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  // HMAC-SHA256(API_KEY_PEPPER, rawKey) — never the raw key itself. Looked
  // up directly by ../../api/src/lib/internalAuth.ts on every /v1/** call.
  // apiKeyPrefix is the first 10 chars of the raw key, kept only for
  // display (CompaniesView) since the hash isn't human-legible.
  apiKeyHash   String   @unique
  apiKeyPrefix String
  apiKeyScope  ApiKeyScope @default(FULL)
  // Set only while a grace-period rotation (PORTAL_MANUAL or AUTOMATIC) is
  // in effect — the old key's hash, still accepted by internalAuth.ts
  // until apiKeyPreviousExpiresAt, so already-running processes have time
  // to pick up the new key before the old one stops working. ADMIN_MANUAL
  // rotation (Service-Provider staff revoking a leaked key) clears both
  // fields instead — that path is an intentional hard cutover.
  apiKeyPreviousHash      String?   @unique
  apiKeyPreviousExpiresAt DateTime?
  apiKeyRotatedAt         DateTime  @default(now())
  // Days between automatic rotations; 0 disables automatic rotation for
  // this company (see api/'s apiKeyRotationScheduler). Keep this at 0 for
  // any tenant with a shipped mobile build until that app can fetch a
  // rotated key at runtime — see customer-portal-mobile/lib/core/api_config.dart.
  apiKeyRotationDays Int @default(90)
  // Where api/'s scheduler pushes a freshly-rotated raw key on automatic
  // rotation (signed with apiKeyWebhookSecret) — see
  // ../../api/src/lib/apiKeyRotationWebhook.ts. Null disables the push;
  // the tenant then relies on its own grace-period poller to notice and
  // prompt a manual rotation instead.
  apiKeyWebhookUrl    String?
  apiKeyWebhookSecret String?
  // Requests per company per minute, enforced by api/'s Redis-backed
  // limiter (see ../../api/src/lib/rateLimit.ts). 0 = unlimited.
  requestsPerMinute Int @default(300)
  contactName  String?
  contactEmail String?  @unique
  contactPhone String?
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  packages       Package[]
  customers      Customer[]
  portalUsers    PortalUser[]
  portalSettings PortalSettings?
  shippingRates  ShippingRate[]
  feeRanges      FeeRange[]
  locations      Location[]
  faqItems       FaqItem[]
  manifests      Manifest[]
  apiKeyRotationEvents ApiKeyRotationEvent[]

  @@map("companies")
}

// Append-only rotation history, one row per rotation regardless of
// trigger — mirrors the PackageStatusEvent pattern below. Never stores a
// raw key, only metadata about the event.
model ApiKeyRotationEvent {
  id                 String                @id @default(cuid())
  companyId          String
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trigger            ApiKeyRotationTrigger
  rotatedAt          DateTime              @default(now())
  gracePeriodEndsAt  DateTime?
  webhookDeliveredAt DateTime?
  webhookAttempts    Int                   @default(0)

  @@index([companyId, rotatedAt])
  @@map("api_key_rotation_events")
}

// Was a read-only mirror of ../customer-portal's own table when that app
// owned and migrated it directly; now admin owns the full field set as the
// sole schema/migration authority, served to every customer-portal
// instance through api/internal/** (see AdminClient in packages/admin-sdk).
//
// id is always the owning company's id (not an autogenerated cuid) — one
// row per company, so many single-tenant customer-portal instances can
// share this table without colliding.
model PortalSettings {
  id             String   @id
  company        Company  @relation(fields: [id], references: [id])
  companyName    String
  logoEmoji      String   @default("📦")
  // An uploaded logo image takes priority over logoEmoji wherever the
  // brand mark is shown (nav headers, contact page). logoEmoji remains
  // the fallback so a company never has to have an image.
  //
  // logoUrl/faviconUrl/heroImageUrl are deprecated — each was a
  // /uploads/ path on whichever customer-portal instance received the
  // upload, unservable once that app loses its own filesystem/DB access.
  // The *Image/*ImageFileName pairs below are the replacement, bytes in
  // this row like Package.generatedInvoicePdf. Real uploaded images
  // existed for these three companies at cutover time — migrated from
  // each instance's public/uploads/ into these columns by a one-off
  // script, not left to re-upload.
  logoUrl        String?
  logoImage         Bytes?
  logoImageFileName String?
  // Shown as the browser tab icon (falls back to Next's default favicon
  // when unset).
  faviconUrl     String?
  faviconImage         Bytes?
  faviconImageFileName String?
  primaryColor   String   @default("#0f172a")
  // The homepage hero's background gradient, shown when no heroImageUrl is
  // set — three stops, top-left to bottom-right.
  gradientFrom   String   @default("#1e1b4b")
  gradientVia    String   @default("#581c87")
  gradientTo     String   @default("#831843")
  heroImageUrl   String?
  heroImage         Bytes?
  heroImageFileName String?
  welcomeMessage String?
  contactEmail   String?
  contactPhone   String?
  updatedAt      DateTime @updatedAt

  // Manifest auto-generation schedule. Time is "HH:mm" in the server's
  // local timezone; days are a subset of MON/TUE/WED/THU/FRI/SAT/SUN.
  manifestAutoGenerate Boolean  @default(false)
  manifestTime         String?
  manifestDays         String[] @default([])

  // The shipping address customers send purchases to (e.g. a US-based
  // warehouse) — configured under customer-portal's /admin/settings, shown
  // to customers on their own /profile page once set.
  warehouseName         String?
  warehouseAddressLine1 String?
  warehouseAddressLine2 String?
  warehouseCity         String?
  warehouseState        String?
  warehouseZip          String?
  warehouseCountry      String?
  warehousePhone        String?

  // Banking details printed on PDF invoices generated when a package
  // reaches READY_FOR_PICKUP (see lib/invoicePdf.ts).
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankBranch        String?

  // This tenant's own email-sending provider — used for signup
  // verification, password reset, the contact form, and package-status
  // notifications instead of the platform's shared RESEND_API_KEY. Only
  // ever read/written by ../../api/src/lib/tenantEmailSender.ts and its
  // ../../warehouse mirror; never exposed through this model's own
  // GET/PATCH route (see the explicit `select`/separate sub-route there).
  // *Encrypted fields hold `iv:authTag:ciphertext` (hex), never plaintext
  // — see settingsEncryption.ts's encryptSecret()/decryptSecret().
  emailProvider          EmailProvider?
  emailFromAddress       String?
  resendApiKeyEncrypted  String?
  smtpHost               String?
  smtpPort               Int?
  smtpUsername           String?
  smtpPasswordEncrypted  String?
  smtpSecure             Boolean        @default(true)

  @@map("portal_settings")
}

model Customer {
  id    String  @id @default(cuid())
  name  String
  // Unique per company rather than globally — the same person can be a
  // customer of two different freight forwarders under one email, which
  // is expected once multiple companies share this database.
  email String
  phone String?
  // Tax Registration Number, collected at self-registration (see
  // ../customer-portal's signup form) and used for customs paperwork.
  // Unique per company for the same reason as email.
  trn   String?
  // Human-readable id shown to the customer as part of their shipping
  // address (their "suite number") — "{company code}-{5-digit sequence}",
  // e.g. "SLP-00001". Set by ../customer-portal on self-registration; see
  // lib/customerCode.ts there. Already globally unique by construction
  // (embeds the company code), so it isn't part of the compound keys below.
  customerCode String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  packages Package[]

  @@unique([companyId, email])
  @@unique([companyId, trn])
  @@map("customers")
}

model Package {
  id                String        @id @default(cuid())
  hawb              Int           @unique @default(autoincrement())
  trackingNumber    String
  status            PackageStatus @default(RECEIVED)
  packageType       PackageType   @default(BOX)
  pieces            Int           @default(1)
  notes             String?
  weightLbs         Float?
  rate              Float?
  cost              Float?
  // Independent of status (see the comment on PaymentStatus) — amountPaid
  // is how much of `cost` has actually been collected, used to compute
  // outstanding balances for PARTIAL payments.
  paymentStatus     PaymentStatus @default(UNPAID)
  amountPaid        Float?        @default(0)
  description       String?
  // Merchandise/customs value, declared by staff — the basis for a
  // value-range FeeRange match (see the comment on that model). Distinct
  // from cost, which is the shipping charge, not the package's value.
  declaredValue     Float?
  // Jamaica Customs Agency duties/fees (https://jca.gov.jm/business/duties-and-taxes/),
  // entered manually by customer-portal staff (LOGGER/ADMIN — see
  // editablePackageFields in customer-portal's lib/rbac.ts) once a
  // package's actual customs charges are known. Each is a PERCENTAGE of
  // declaredValue, not a flat dollar amount — see dutyAmount() in
  // customer-portal's lib/rbac.ts and both apps' lib/invoicePdf.ts for
  // the dollar conversion. Null means "not applicable to this package",
  // not zero — only non-null duties are summed into the invoice total.
  // The customer-portal edit UI only allows entering these once
  // declaredValue is at least $100.
  dutyImportDuty            Float?
  dutyStampDuty             Float?
  dutyAdditionalStampDuty   Float?
  dutyGct                   Float?
  dutySct                   Float?
  dutyStandardComplianceFee Float?
  dutyEnvironmentalLevy     Float?
  dutyCustomsAdminFee       Float?
  // Set by ../customer-portal's/../warehouse's fee calculator when staff
  // match this package's weightLbs or declaredValue against a configured
  // FeeRange tier — null until a fee has actually been generated for this
  // package. Once set, shown on the generated invoice PDF and on the
  // package card/detail views (see the comment on FeeRange for the wider
  // feature).
  calculatedFee     Float?
  calculatedFeeBasis FeeBasis?
  calculatedFeeAt   DateTime?
  // Customer-uploaded invoice/receipt for this shipment — set by
  // ../customer-portal's /my-shipments detail page (customer role only);
  // one slot, replaced on re-upload rather than kept as a history.
  // invoiceUrl is deprecated (was a /uploads/ path on whichever
  // customer-portal instance received the upload — no longer written once
  // that app loses direct filesystem/DB access); invoiceImage is the
  // replacement, bytes in this row like generatedInvoicePdf below. Kept
  // both during the cutover; invoiceUrl has no real data as of this
  // migration (verified against the live DB).
  invoiceUrl        String?
  invoiceImage      Bytes?
  invoiceFileName   String?
  invoiceUploadedAt DateTime?
  // Pre-alert-only fields, set by the customer when creating a PENDING
  // package — see the write-exception comment in ../customer-portal's own
  // schema.prisma.
  merchantName      String?
  additionalDetails String?

  // The PDF generated and emailed to the customer when the package
  // reaches READY_FOR_PICKUP or DELIVERED (see lib/packageStatusNotify.ts
  // and lib/invoicePdf.ts, both apps) — separate from invoiceUrl above,
  // which is the customer's own uploaded receipt. Stored as bytes (not a
  // file path) since either app can generate it and the two are separate
  // deployments with separate filesystems. Served by GET
  // /api/packages/[id]/invoice in both apps.
  generatedInvoicePdf      Bytes?
  generatedInvoiceFileName String?
  generatedInvoiceAt       DateTime?

  // Null only while status is PENDING — a customer-created pre-alert has
  // no warehouse staff member and no real arrival time yet. Both are set
  // when a matching package is actually logged (same company,
  // trackingNumber, and pieces) — see POST /api/packages, which updates
  // the existing PENDING row in place instead of creating a duplicate.
  receivedById String?
  receivedBy   User?     @relation("PackagesLoggedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents PackageStatusEvent[]
  deliveryAssignments DeliveryAssignment[]

  @@index([trackingNumber])
  @@index([receivedAt])
  @@map("packages")
}

// A log of every Package.status transition, written by whichever app made
// the change (this app's package routes, or ../customer-portal's own
// package-edit route and manifest generation — see the comment on that
// app's mirror of this model). changedByLabel is a free-text description
// rather than a strict FK since the actor might be a User row here, a
// PortalUser row in ../customer-portal's own database, or an automated
// process (manifest generation) — no single table could hold all three.
model PackageStatusEvent {
  id             String         @id @default(cuid())
  fromStatus     PackageStatus?
  toStatus       PackageStatus
  changedByLabel String
  changedAt      DateTime       @default(now())

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@map("package_status_events")
}

// Was a write-mirror of ../customer-portal's own portal_users table when
// that app owned and migrated it directly; now admin owns the full field
// set as the sole schema/migration authority, served to every
// customer-portal instance through api/internal/** (see AdminClient in
// packages/admin-sdk). The company-registration flow (POST /api/companies)
// still creates the tenant's initial ADMIN account directly here, with an
// OTP as its password and mustChangePassword set, so the registered email
// can log in to that customer-portal deployment immediately.
model PortalUser {
  id                 String     @id @default(cuid())
  name               String
  email              String
  passwordHash       String
  role               PortalRole @default(CUSTOMER)
  active             Boolean    @default(true)
  // Set true for accounts created via the admin app's company-registration
  // flow (an OTP as their initial password) — cleared on their first
  // successful password change, which customer-portal forces before
  // anything else.
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Customer registration details (from customer-portal's public signup
  // form). Nullable — staff accounts (ADMIN/CSR/DRIVER) are created
  // without these and never need them; only CUSTOMER signups fill them in.
  firstName       String?
  middleInitial   String?
  lastName        String?
  phone           String?
  workPhone       String?
  addressLine1    String?
  addressLine2    String?
  cityParish      String?
  country         String?
  trn             String?
  storeLocation   String?
  termsAcceptedAt DateTime?

  // Deprecated — see the identical note on PortalSettings.logoUrl.
  // Verified zero real data at cutover time, so avatarImage needed no
  // migration.
  avatarUrl String?
  avatarImage         Bytes?
  avatarImageFileName String?

  emailVerified            Boolean   @default(false)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  deliveries          DeliveryAssignment[]     @relation("AssignedDriver")
  requestedDeliveries DeliveryAssignment[]     @relation("DeliveryRequestedBy")
  authorizedPickups   AuthorizedPickupPerson[]

  @@unique([companyId, email])
  @@map("portal_users")
}

// Named on a CUSTOMER's own profile as someone else permitted to collect
// their packages in person — informational only today (no check against
// this list happens anywhere else in the app yet).
model AuthorizedPickupPerson {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  relationship String?
  createdAt    DateTime @default(now())

  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id])

  @@index([portalUserId])
  @@map("authorized_pickup_people")
}

model ShippingRate {
  id           String   @id @default(cuid())
  label        String
  minWeightLbs Float
  maxWeightLbs Float?
  price        Float
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("shipping_rates")
}

// Admin-configured fee tiers, one table for both the weight-range and
// value-range calculators (basis picks which) — same
// min/max/label/sortOrder shape as ShippingRate, but these produce a flat
// fee (customs/handling-style) rather than a shipping cost, matched by
// ../customer-portal's fee calculator (admin/CSR only) against a specific
// package's weightLbs or declaredValue. Applying a match writes
// Package.calculatedFee/calculatedFeeBasis/calculatedFeeAt.
model FeeRange {
  id        String   @id @default(cuid())
  basis     FeeBasis
  label     String
  min       Float
  max       Float?
  fee       Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId, basis])
  @@map("fee_ranges")
}

model Location {
  id            String   @id @default(cuid())
  name          String
  address       String
  contactNumber String
  hoursMonFri   String
  hoursSat      String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("locations")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  subheader String?
  answer    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("faq_items")
}

model Manifest {
  id           String   @id @default(cuid())
  generatedAt  DateTime @default(now())
  packageCount Int
  // Point-in-time snapshot of the RECEIVED packages captured — kept even
  // if the underlying packages later change status again, so a manifest
  // always reflects what was actually manifested.
  packages     Json
  triggeredBy  String   @default("MANUAL")

  // The Service-Provider platform's own billing invoice for this manifest
  // (packageCount * the platform's global per-package rate, admin's
  // PlatformSettings.perPackageRate, at generation time — see
  // /dashboard/manifests) — distinct from Package.generatedInvoicePdf,
  // which is the freight forwarder billing its own customer. Null until
  // generated; regenerating overwrites all four fields together.
  invoiceAmount      Float?
  invoicePdf         Bytes?
  invoiceFileName    String?
  invoiceGeneratedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("manifests")
}

model DeliveryAssignment {
  id          String         @id @default(cuid())
  status      DeliveryStatus @default(REQUESTED)
  notes       String?
  assignedAt  DateTime       @default(now())
  deliveredAt DateTime?
  updatedAt   DateTime       @updatedAt

  // Where to deliver — defaulted from the requesting customer's own
  // PortalUser address at request time (see the comment on requestedById),
  // then editable independently of it (a one-off delivery address doesn't
  // have to match, or stay in sync with, their profile address).
  addressLine1 String
  addressLine2 String?
  cityParish   String
  country      String

  // Proof of delivery captured by the driver mobile app when marking a
  // delivery complete (see customer-portal's api/mobile/deliveries/[id]/
  // complete). Stored as bytes on this row rather than a file path — see
  // the identical rationale on Package.generatedInvoicePdf below.
  proofPhoto      Bytes?
  proofSignature  Bytes?
  proofCapturedAt DateTime?

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  // Null while status is REQUESTED — a customer can request home delivery
  // for an undelivered package (../customer-portal's shipment detail page)
  // before staff (ADMIN/CSR) assign it to a specific driver, at which
  // point both driverId and status (→ ASSIGNED) are set together. Staff
  // can still create an assignment with a driver already attached
  // directly, skipping REQUESTED entirely.
  driverId String?
  driver   PortalUser? @relation("AssignedDriver", fields: [driverId], references: [id])

  // The CUSTOMER-role PortalUser who requested this delivery, when it
  // originated that way — null for assignments staff created directly
  // (e.g. from a walk-in pickup they're converting to delivery).
  requestedById String?
  requestedBy   PortalUser? @relation("DeliveryRequestedBy", fields: [requestedById], references: [id])

  @@map("delivery_assignments")
}
